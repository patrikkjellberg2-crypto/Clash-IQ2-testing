<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/clashiq_widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚔️ BHABE DHEMONS"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="NO ACTIVE WAR"
        android:textColor="#F0C75E"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_opponent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="vs —"
        android:textColor="#C8CDD5"
        android:textSize="12sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="⭐ — ⭐"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_destruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#AEB4BF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_attacks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="ATTACKS LEFT: —"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_latest_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="LATEST ATTACKS"
        android:textColor="#AEB4BF"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_latest_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No attacks yet"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_latest_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#D7DBE2"
        android:textSize="10sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_latest_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#D7DBE2"
        android:textSize="10sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_timer_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="WAR ENDS IN"
        android:textColor="#AEB4BF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#F0C75E"
        android:textSize="22sp"
        android:textStyle="bold"
        android:countDown="true"
        android:format="%s" />
</LinearLayout>